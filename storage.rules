rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin media uploads must come from an authenticated Firebase user.
    // Candidate-facing assets remain readable once a download URL has been generated.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
